require "open3"

default_platform(:ios)

# Every embedded executable needs its own installed provisioning profile.
SIGNING_TARGETS = {
  "CevizBridge" => "com.mertbasar.cevizwatch",
  "CevizWatchApp" => "com.mertbasar.cevizwatch.watchkitapp",
  "CevizWatchWidget" => "com.mertbasar.cevizwatch.watchkitapp.widget"
}.freeze

WATCH_BUNDLE_ID = SIGNING_TARGETS.fetch("CevizWatchApp")
WIDGET_BUNDLE_ID = SIGNING_TARGETS.fetch("CevizWatchWidget")

def asc_key
  app_store_connect_api_key(
    key_id: ENV["ASC_KEY_ID"],
    issuer_id: ENV["ASC_ISSUER_ID"],
    key_filepath: ENV["ASC_KEY_PATH"]
  )
end

def ensure_watch_push_capability
  bundle_id = Spaceship::ConnectAPI::BundleId.find(WATCH_BUNDLE_ID)
  UI.user_error!("Watch bundle ID not found: #{WATCH_BUNDLE_ID}") unless bundle_id

  push_type = "PUSH_NOTIFICATIONS"
  existing = bundle_id.get_capabilities.any? do |capability|
    capability.capability_type.to_s == push_type
  end
  if existing
    UI.success("Watch Push Notifications capability is already enabled")
  else
    bundle_id.create_capability(push_type)
    UI.success("Enabled Watch Push Notifications capability")
  end
end

def ensure_widget_bundle_id
  return if Spaceship::ConnectAPI::BundleId.find(WIDGET_BUNDLE_ID)

  widget = Spaceship::ConnectAPI::BundleId.create(
    identifier: WIDGET_BUNDLE_ID,
    name: "Ceviz Watch Voice Widget",
    platform: "IOS"
  )
  UI.user_error!("Could not register Ceviz Watch widget bundle ID") unless widget&.identifier == WIDGET_BUNDLE_ID
  UI.success("Registered Ceviz Watch widget bundle ID")
end

def provisioning_mode_options(method)
  # Sigh rejects mutually exclusive keys even when explicitly set to false.
  case method
  when "app-store" then {}
  when "development" then { development: true }
  when "ad-hoc" then { adhoc: true }
  else UI.user_error!("Unsupported Ceviz provisioning method: #{method}")
  end
end

# Her hedef icin distribution provisioning profili olustur/getir (cloud signing DEGIL)
def provision(api_key, method)
  mode_options = provisioning_mode_options(method)
  profiles = {}
  SIGNING_TARGETS.each_value do |bid|
    get_provisioning_profile(
      api_key: api_key,
      app_identifier: bid,
      force: bid == WATCH_BUNDLE_ID,
      output_path: "build/profiles",
      **mode_options
    )
    profiles[bid] = lane_context[SharedValues::SIGH_NAME]
    UI.success("Profile #{bid}: #{profiles[bid]}")
  end
  profiles
end

def configure_manual_signing(profiles, method)
  # The imported identity signs the archive and export. Automatic archive signing
  # created throwaway development certificates; never create or revoke them here.
  SIGNING_TARGETS.each do |target, bid|
    update_code_signing_settings(
      path: "CevizWatch.xcodeproj",
      targets: [target],
      build_configurations: ["Release"],
      use_automatic_signing: false,
      team_id: ENV.fetch("TEAM_ID"),
      code_sign_identity: method == "development" ? "Apple Development" : "Apple Distribution",
      profile_name: profiles.fetch(bid)
    )
  end
end

def require_internal_only_export_support
  output, errors, status = Open3.capture3("xcodebuild", "-help")
  help = output + errors
  contract = help.match(/^\s*testFlightInternalTestingOnly\s*:\s*Bool\s*\n(?:[^\n]*\n){0,3}/)
  UI.user_error!("Selected Xcode does not advertise the internal-only export contract") unless status.success? && contract
  UI.message("Native internal-only export contract: #{contract[0].strip}")
end

def build_ceviz(api_key, method, internal_only: false)
  require_internal_only_export_support if internal_only
  ensure_watch_push_capability
  ensure_widget_bundle_id
  profiles = provision(api_key, method)
  configure_manual_signing(profiles, method)
  build_number = Time.now.to_i.to_s # benzersiz, artan build numarasi
  UI.message("Build number: #{build_number}")
  build_app(
    project: "CevizWatch.xcodeproj",
    scheme: "CevizBridge",
    configuration: "Release",
    export_method: method,
    clean: true,
    skip_package_dependencies_resolution: true,
    skip_profile_detection: true,
    xcargs: "CURRENT_PROJECT_VERSION=#{build_number}",
    output_directory: "build/ipa",
    output_name: "CevizWatch.ipa",
    export_options: {
      signingStyle: "manual",
      teamID: ENV["TEAM_ID"],
      provisioningProfiles: profiles,
      **(internal_only ? { testFlightInternalTestingOnly: true } : {})
    }
  )
end

platform :ios do
  desc "CevizWatch IPA build (manuel imzalama)"
  lane :build do
    method = (ENV["EXPORT_METHOD"] && !ENV["EXPORT_METHOD"].empty? ? ENV["EXPORT_METHOD"] : "app-store")
    build_ceviz(asc_key, method)
  end

  desc "CevizWatch -> TestFlight (watch app icin temiz kurulum yolu)"
  lane :beta do
    candidate = case ENV.fetch("CEVIZ_DEVICE_CHECK_CANDIDATE", "false")
                when "true" then true
                when "false" then false
                else UI.user_error!("Device-check candidate must be explicitly true or false")
                end
    key = asc_key
    build_ceviz(key, "app-store", internal_only: candidate)
    if candidate
      # Check the exact plist generated for this archive, not another file or
      # merely our requested hash. A missing/changed export blocks the upload.
      value, _, status = Open3.capture3("/usr/libexec/PlistBuddy", "-c", "Print :testFlightInternalTestingOnly",
                                       Gym::PackageCommandGeneratorXcode7.config_path)
      UI.user_error!("Generated export is not Internal Only; upload stopped") unless status.success? && value.strip == "true"
      UI.success("Verified generated Internal Only export; physical Watch checks remain pending")
    end
    upload_to_testflight(
      api_key: key,
      skip_waiting_for_build_processing: true,
      skip_submission: true,
      distribute_external: false,
      notify_external_testers: false,
      ipa: lane_context[SharedValues::IPA_OUTPUT_PATH]
    )
  end
end
