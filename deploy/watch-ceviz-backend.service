[Unit]
Description=Watch Ceviz Backend (PTT->Summary, local Whisper STT)
After=network-online.target

[Service]
Type=simple
# Template only. Prefer `bash deploy/install.sh`, which writes absolute paths,
# the generated token, and the selected model for the current installation.
WorkingDirectory=/absolute/path/to/ceviz
Environment=WATCH_CEVIZ_STT_ENGINE=auto
# GPU icin: venv icindeki nvidia cublas+cudnn lib dizinleri
# Environment=LD_LIBRARY_PATH=<venv>/lib/python3.12/site-packages/nvidia/cublas/lib:<venv>/lib/python3.12/site-packages/nvidia/cudnn/lib
Environment=WATCH_CEVIZ_WHISPER_MODEL=large-v3
Environment=WATCH_CEVIZ_WHISPER_LANGUAGE=tr
Environment=OPENCLAW_WATCH_AGENT=main
# Uretimde zorunlu: openssl rand -hex 24 ile uret, telefonda Ayarlar ekranina gir
Environment=WATCH_CEVIZ_AUTH_TOKEN=CHANGE_ME
ExecStart=/absolute/path/to/ceviz/.venv/bin/python /absolute/path/to/ceviz/backend/main.py 8080
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
